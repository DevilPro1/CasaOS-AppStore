{
  "name": "raspap",
  "version": "latest",
  "title": "RaspAP",
  "description": "Wireless Access Point / Hotspot manager",
  "icon": "https://docs.raspap.com/img/RaspAP-logo.png",

  "ports": [
    {
      "container": "80",
      "host": "8081",
      "type": "http"
    }
  ],

  "env": [
    {
      "name": "TZ",
      "value": "Europe/Madrid"
    }
  ],

  "privileged": true,
  "network_mode": "host"
}